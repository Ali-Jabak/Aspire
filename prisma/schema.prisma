generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  LIBRARIAN
  USER
}

enum BookStatus {
  AVAILABLE
  CHECKED_OUT
  RESERVED
  MAINTENANCE
}

enum CheckoutStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

enum MediaStatus {
  OWNED
  WISHLIST
  CURRENTLY_USING
  COMPLETED
}

enum RecipeStatus {
  FAVORITE
  TO_TRY
  MADE_BEFORE
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  ORDERED
  DISCONTINUED
}

// ─── Auth Models (NextAuth / Auth.js) ────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  addedBooks     Book[]           @relation("AddedBooks")
  checkouts      CheckoutRecord[]
  bookReviews    BookReview[]
  mediaItems       MediaItem[]
  profile          Profile?
  recipes          Recipe[]
  sharedRecipes    RecipeShare[]  @relation("SharedWithUser")
  recipesSharedWith RecipeShare[]  @relation("SharedByUser")
  inventoryItems   InventoryItem[]
  events           Event[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Library Module ───────────────────────────────────────────────────────────

model Book {
  id              String     @id @default(cuid())
  title           String
  author          String
  isbn            String?    @unique
  description     String?    @db.Text
  coverUrl        String?
  genre           String?
  publisher       String?
  publishedYear   Int?
  language        String?    @default("English")
  pageCount       Int?
  tags            String[]
  totalCopies     Int        @default(1)
  availableCopies Int        @default(1)
  status          BookStatus @default(AVAILABLE)
  location        String?
  addedByUserId   String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  addedBy   User             @relation("AddedBooks", fields: [addedByUserId], references: [id])
  checkouts CheckoutRecord[]
  reviews   BookReview[]
}

model CheckoutRecord {
  id           String         @id @default(cuid())
  bookId       String
  userId       String
  checkedOutAt DateTime       @default(now())
  dueDate      DateTime
  returnedAt   DateTime?
  status       CheckoutStatus @default(ACTIVE)
  notes        String?

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BookReview {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId])
}

// ─── Media Module ─────────────────────────────────────────────────────────────

model MediaItem {
  id            String      @id @default(cuid())
  title         String
  type          String      // MOVIE, MUSIC, GAME or sub-types: TV Show, Album, etc.
  creator       String?     // director, artist, developer, etc.
  description   String?     @db.Text
  url           String?
  thumbnailUrl  String?
  genre         String?
  rating        Int?
  releaseDate   DateTime?
  completedAt   DateTime?   // when marked completed / finished
  status        MediaStatus @default(OWNED)
  userId        String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  slug        String   @unique  // for /profile/[slug] share URL
  displayName String?
  bio         String?  @db.Text
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Recipe Module ────────────────────────────────────────────────────────────

model Recipe {
  id           String       @id @default(cuid())
  title        String
  description  String?      @db.Text
  ingredients  String?      @db.Text
  instructions String?      @db.Text
  prepTime     Int?
  cookTime     Int?
  servings     Int?
  imageUrl     String?
  category     String?
  cuisine      String?
  status       RecipeStatus?
  shareSlug    String?      @unique  // public read-only link when set
  userId       String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares RecipeShare[]
}

model RecipeShare {
  id        String   @id @default(cuid())
  recipeId  String
  userId    String   // user this recipe is shared with
  canEdit   Boolean  @default(false)
  sharedAt  DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation("SharedWithUser", fields: [userId], references: [id], onDelete: Cascade)
  sharedBy User @relation("SharedByUser", fields: [sharedById], references: [id], onDelete: Cascade)
  sharedById String

  @@unique([recipeId, userId])
}

// ─── Inventory Module ─────────────────────────────────────────────────────────

model InventoryItem {
  id          String          @id @default(cuid())
  name        String
  description String?         @db.Text
  quantity    Int             @default(0)
  unit        String?
  category    String?
  location    String?
  minQuantity Int?
  status      InventoryStatus @default(IN_STOCK)
  userId      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Event Module ─────────────────────────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  startDate   DateTime
  endDate     DateTime?
  location    String?
  isAllDay    Boolean   @default(false)
  color       String?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
